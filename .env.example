# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/psiquiatriapp?schema=public

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google SSO
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT (change in production)
JWT_SECRET=your-secure-jwt-secret-here

# Google Calendar / Meet (optional, for virtual appointments)
GOOGLE_CALENDAR_REFRESH_TOKEN=your_google_calendar_refresh_token

# Twilio (SMS / WhatsApp reminders)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000
TWILIO_WHATSAPP_NUMBER=+10000000000

# Vercel Cron (protects /api/cron/reminders)
CRON_SECRET=your-cron-secret-here
